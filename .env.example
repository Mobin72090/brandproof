# BrandProof Environment Configuration Template
# Copy this file to .env and supply your values

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DATABASE_PATH=brandproof.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI Integration (Google Gemini)
# Leave blank to run in 100% deterministic rule-based mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
